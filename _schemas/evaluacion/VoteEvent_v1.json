{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VoteEvent_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_esquema",
    "event_id",
    "timestamp_utc",
    "caso_id",
    "ticker",
    "fecha_caso",
    "step_name",
    "operation",
    "score_raw_0_100",
    "vote_file",
    "rules_failed",
    "config_hash"
  ],
  "properties": {
    "version_esquema": {
      "type": "string",
      "const": "VoteEvent_v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "caso_id": { "type": "string", "minLength": 1 },
    "ticker": { "type": "string", "minLength": 1 },
    "fecha_caso": { "type": "string", "format": "date" },
    "step_name": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "score_raw_0_100": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "vote_file": { "type": "string", "minLength": 1 },
    "rules_failed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "config_hash": {
      "type": "string",
      "minLength": 32
    },
    "model": { "type": ["string", "null"] },
    "backend": { "type": ["string", "null"] },
    "canonical_step_name": { "type": ["string", "null"] },
    "subject_kind": {
      "type": ["string", "null"],
      "enum": ["fusion", "per_model", null]
    },
    "vote_group_id": { "type": ["string", "null"] }
  }
}
