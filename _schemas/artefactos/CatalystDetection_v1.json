{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CatalystDetection_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_esquema",
    "caso_id",
    "fecha_corte",
    "claims_list",
    "catalyst_candidates"
  ],
  "properties": {
    "version_esquema": { "type": "string", "const": "CatalystDetection_v1" },
    "caso_id": { "type": "string", "minLength": 1 },
    "fecha_corte": { "type": "string", "format": "date" },
    "ticker": { "type": ["string", "null"] },
    "claims_list": {
      "type": "array",
      "items": { "type": "object" }
    },
    "catalyst_candidates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "input_refs": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "log": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "_meta": {
      "type": ["object", "null"],
      "additionalProperties": true
    }
  }
}
