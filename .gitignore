# Outputs (keep structure, ignore generated files)
# Uncomment if you want to gitignore all case artifacts:
# casos/*/*/*.json
# _scanner/*/*.json

# Deterministic module — generated outputs (regenerable via CLI)
deterministic/cases/*/extraction_result.json
deterministic/cases/*/filings_manifest.json
deterministic/cases/*/filings/
deterministic/cases/*/*.prev.json

# Keep directory structure
!casos/.gitkeep
!tmp/.gitkeep
!_scanner/.gitkeep
