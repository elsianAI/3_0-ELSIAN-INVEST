{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ForensicDetection_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_esquema",
    "caso_id",
    "fecha_corte",
    "red_flags",
    "liquidez",
    "puentes",
    "kill_criteria_candidatos"
  ],
  "properties": {
    "version_esquema": {
      "type": "string",
      "const": "ForensicDetection_v1"
    },
    "caso_id": {
      "type": "string",
      "minLength": 1
    },
    "fecha_corte": {
      "type": "string",
      "format": "date"
    },
    "ticker": {
      "type": [
        "string",
        "null"
      ]
    },
    "red_flags": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "liquidez": {
      "type": "object",
      "additionalProperties": true
    },
    "puentes": {
      "type": "object",
      "additionalProperties": true
    },
    "kill_criteria_candidatos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "report_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_refs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "log": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "_meta": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  }
}