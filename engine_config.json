  "pipeline_dag": {
    "PIPELINE": [
      {
        "step": "PREFETCH",
        "type": "python",
        "runners": [
          "sec_fetcher",
          "market_data",
          "transcript_finder"
        ],
        "parallel": true,
        "pipeline_key": "SOURCES"
      },
      {
        "step": "SOURCES_COMPILER",
        "type": "python",
        "runner": "sources_compiler",
        "pipeline_key": "SOURCES"
      },
      {
        "step": "TP_EXTRACTOR_FILING",
        "type": "llm_per_filing",
        "instruction": "instrucciones_tp_extractor_filing_V1.md",
        "pipeline_key": "TRUTH_PACK"
      },
      {
        "step": "TP_EXTRACTOR_MERGER",
        "type": "python",
        "runner": "tp_extractor_merger",
        "pipeline_key": "TRUTH_PACK"
      },
      {
        "step": "TP_CALCULATOR",
        "type": "python",
        "runner": "tp_calculator",
        "pipeline_key": "TRUTH_PACK"
      },
      {
        "step": "TP_VALIDATOR",
        "type": "python",
        "runner": "tp_validator",
        "pipeline_key": "TRUTH_PACK"
      },
      {
        "step": "IMPLIED",
        "type": "llm",
        "instruction": "instrucciones_implied_V4.md",
        "pipeline_key": "IMPLIED"
      },
      {
        "step": "CATALYST_DETECTION",
        "type": "llm",
        "instruction": "instrucciones_catalyst_detection_V1.md",
        "pipeline_key": "CATALYST",
        "parallel_group": "CATFOR"
      },
      {
        "step": "CATALYST_SCORING",
        "type": "llm",
        "instruction": "instrucciones_catalyst_scoring_V1.md",
        "pipeline_key": "CATALYST",
        "depends_on": "CATALYST_DETECTION"
      },
      {
        "step": "FORENSIC_DETECTION",
        "type": "llm",
        "instruction": "instrucciones_forensic_detection_V1.md",
        "pipeline_key": "FORENSIC",
        "parallel_group": "CATFOR"
      },
      {
        "step": "FORENSIC_SCORING",
        "type": "llm",
        "instruction": "instrucciones_forensic_scoring_V1.md",
        "pipeline_key": "FORENSIC",
        "depends_on": "FORENSIC_DETECTION"
      },
      {
        "step": "BULL",
        "type": "llm",
        "instruction": "instrucciones_bull_V4.md",
        "pipeline_key": "BULL"
      },
      {
        "step": "RED_TEAM",
        "type": "llm",
        "instruction": "instrucciones_red_team_V4.md",
        "pipeline_key": "RED_TEAM"
      },
      {
        "step": "ARBITRO",
        "type": "llm",
        "instruction": "instrucciones_arbitro_V6.md",
        "pipeline_key": "ARBITRO"
      },
      {
        "step": "QUALITY_AUDIT",
        "type": "python",
        "runner": "quality_audit",
        "pipeline_key": null
      }
    ],
    "MONITOR": [
      {
        "step": "MONITOR",
        "type": "llm",
        "instruction": "instrucciones_monitor_V2.md",
        "pipeline_key": null,
        "requires": ["tools", "web_access"]
      }
    ],
    "SCANNER": [
      {
        "step": "SCANNER",
        "type": "llm",
