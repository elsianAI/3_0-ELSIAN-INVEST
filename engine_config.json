    }
  },
  "multi_model_steps": {
    "min_backends": 3,
    "steps": {
      "CATALYST_DETECTION": {
        "fusion_instruction": "instrucciones_fusion_catalyst_detection_V1.md"
      },
      "FORENSIC_DETECTION": {
        "fusion_instruction": "instrucciones_fusion_forensic_detection_V1.md"
      },
