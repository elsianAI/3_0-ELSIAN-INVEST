      },
      "RED_TEAM": {
        "fusion_instruction": "instrucciones_fusion_V1.md"
      },
      "ARBITRO": {
        "fusion_instruction": "instrucciones_fusion_V1.md",
        "min_backends": 2
      }
    }
  },
  "escalation": {
    "enabled": false,
    "_nota": "Deprecado en v2. Mantener flag durante una release para rollback seguro."
  },
  "git": {
    "enabled": true,
    "push_on_command_end": true,
    "commit_on_failure": false,
    "remote": "origin",
    "stage_paths": ["CHANGELOG.md"]
  },
  "execution": {
    "codex_approval_policy": "full-auto",
    "codex_sandbox": "false",
    "max_parallel_filings": 8,
    "max_parallel_backends": 3,
    "tp_extractor_per_filing_timeout": 300,
    "python_step_timeouts": {
      "PREFETCH": 900
